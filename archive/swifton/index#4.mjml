<mjml lang="en" dir="ltr">
    <mj-head>
        <mj-title>Grace and Rapid Mentor: Live Webinars and a Free 30-Day Trial</mj-title>
        <mj-preview>Two live Grace webinars this September, plus a free 30-day trial of Grace and Rapid Mentor for existing customers.</mj-preview>
        <mj-breakpoint width="600px" />
        <mj-attributes>
            <mj-all font-family="Ubuntu, Arial, sans-serif" />
            <mj-text padding="0" color="#3a3a4a" font-size="16px" line-height="1.65" />
            <mj-section padding="0" />
            <mj-class name="heading" padding="20px 32px 8px" color="#0070f3" font-size="26px" font-weight="700" line-height="1.25" letter-spacing="-0.01em" />
            <mj-class name="subheading" padding="16px 32px 4px" color="#0070f3" font-size="19px" font-weight="700" line-height="1.3" letter-spacing="-0.005em" />
            <mj-class name="paddit" padding="8px 32px" color="#3a3a4a" font-size="16px" font-weight="400" line-height="1.65" />
            <mj-class name="lead" padding="8px 32px" color="#2a2a3a" font-size="17px" font-weight="400" line-height="1.65" />
            <mj-class name="date" padding="0 32px" color="#1e5bbf" font-size="14px" font-weight="500" align="right" letter-spacing="0.02em" />
            <mj-class name="header-title" padding="16px 32px 4px" color="#0070f3" font-size="28px" font-weight="700" line-height="1.2" letter-spacing="-0.015em" />
            <mj-class name="header-tagline" padding="0 32px 16px" color="#1e5bbf" font-size="15px" font-weight="600" letter-spacing="0.04em" />
            <mj-class name="header-issue" padding="0 32px 16px" color="#1e5bbf" font-size="15px" font-weight="600" letter-spacing="0.08em" />
            <mj-class name="event-label" padding="18px 32px 2px" color="#1e5bbf" font-size="13px" font-weight="700" letter-spacing="0.09em" />
            <mj-class name="event-name" padding="0 32px 4px" color="#0070f3" font-size="18px" font-weight="700" line-height="1.35" />
            <mj-class name="event-meta" padding="0 32px 8px" color="#3a3a4a" font-size="15px" font-weight="500" line-height="1.6" />
            <mj-class name="cta-heading" padding="8px 25px" color="#0070f3" font-size="24px" font-weight="700" line-height="1.3" align="center" letter-spacing="-0.01em" />
            <mj-class name="cta-text" padding="8px 32px 20px" color="#3a3a4a" font-size="16px" line-height="1.65" align="center" />
            <mj-class name="footer-text" padding="8px 25px" color="#7a7a8a" font-size="13px" line-height="1.5" align="center" />
            <mj-button background-color="#0070f3" color="#ffffff" font-size="16px" font-weight="600" inner-padding="14px 36px" border-radius="8px" letter-spacing="0.02em" />
            <mj-divider border-color="#d8e7fb" border-width="1px" padding="20px 32px 4px" />
            <mj-social icon-size="28px" mode="horizontal" align="center" inner-padding="0 8px" />
        </mj-attributes>
        <mj-html-attributes>
            <mj-selector path=".flexy table">
                <mj-html-attribute name="data-id">42</mj-html-attribute>
            </mj-selector>
        </mj-html-attributes>
        <mj-style>
            .flexy table { margin: 0; }
            a { color: #0070f3; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; transition: color 0.2s ease; }
            a:hover { color: #1e5bbf; }
            .article-list { margin: 4px 0 0; padding-left: 22px; }
            .article-list li { margin-bottom: 10px; line-height: 1.65; padding-left: 4px; }
            .article-list li::marker { color: #1e5bbf; }
            strong { color: #0070f3; font-weight: 700; }
            @media only screen and (max-width: 600px) {
                .mobile-pad { padding: 16px 8px !important; }
                .mobile-center { text-align: center !important; }
                .mobile-center img { margin: 0 auto !important; }
            }
        </mj-style>
    </mj-head>
    <mj-body width="1080px" background-color="#f0f6ff">
        <mj-include path="assets/styles/screen.css" type="css" />
        <mj-raw><!-- Message body --></mj-raw>

        <mj-raw><!-- Top accent bar --></mj-raw>
        <mj-section background-color="#0070f3" padding="0">
            <mj-column>
                <mj-spacer height="4px" />
            </mj-column>
        </mj-section>

        <mj-raw><!-- Header --></mj-raw>
        <mj-section background-color="#dfd9fd" background-size="cover" background-repeat="no-repeat" padding="28px 8px">
            <mj-column vertical-align="middle" width="60%">
                <mj-text mj-class="header-title">Swifton Solutions Newsletter</mj-text>
                <mj-text mj-class="header-issue">AUGUST 2026  ·  ISSUE #4</mj-text>
            </mj-column>
            <mj-column vertical-align="middle" width="40%" css-class="mobile-center">
                <mj-image align="right" width="200px" padding="0 24px" src="assets/images/swifton.png" alt="Swifton Solutions Logo" title="Swifton Solutions" />
                <mj-text mj-class="date" css-class="update-date"></mj-text>
            </mj-column>
        </mj-section>

        <mj-raw><!-- Main content --></mj-raw>
        <mj-section background-color="#ffffff" padding="36px 8px 24px">
            <mj-column vertical-align="middle">
                <mj-text mj-class="lead" padding="0 32px 12px">Dear {firstName},</mj-text>
                <mj-text mj-class="paddit">We have two things to share this month, both aimed at helping you get more out of the systems you already work with us on: governance and risk management with <strong>Grace</strong>, and staff development with <strong>Rapid Mentor</strong>.</mj-text>
                <mj-text mj-class="paddit">Part of our approach at Rapid is to take solutions we have built for the public sector and make them available to the wider Rapid community at minimum cost, so existing customers benefit first, without the enterprise price tag.</mj-text>
                <mj-text mj-class="paddit">Because you are already part of the Rapid family, we would like to offer you a <strong>free 30-day trial</strong> of each.</mj-text>

                <mj-divider />

                <mj-text mj-class="heading">Grace: Governance, Risk, Compliance &amp; Audit</mj-text>
                <mj-text mj-class="paddit">Grace has been helping local authorities manage risk since 2003, with a large existing user group. If risk registers, audit tracking or committee reporting in your authority still rely on spreadsheets and manual reformatting each quarter, we can show you how Grace can help.</mj-text>

                <mj-text mj-class="subheading">Two live webinars in September</mj-text>

                <mj-text mj-class="event-label">FOR CURRENT CUSTOMERS</mj-text>
                <mj-text mj-class="event-name">Grace: Governance, Risk &amp; Compliance Solutions for the Public Sector</mj-text>
                <mj-text mj-class="event-meta">Wednesday 9 September 2026, 11:00am to 11:45am<br />Microsoft Teams</mj-text>
                <mj-button align="left" padding="4px 32px 8px" href="https://events.teams.microsoft.com/event/2fd1dd4b-d5a3-4d72-ae35-9099e38035c5@cb480f9d-c52c-4096-a621-442810be7029" title="Reserve your seat, Wednesday 9 September">Reserve your seat</mj-button>

                <mj-text mj-class="event-label">OPEN TO ALL</mj-text>
                <mj-text mj-class="event-name">Grace: Governance, Risk &amp; Compliance Solutions for the Public Sector</mj-text>
                <mj-text mj-class="event-meta">Thursday 10 September 2026, 11:00am to 11:45am<br />Microsoft Teams</mj-text>
                <mj-button align="left" padding="4px 32px 8px" href="https://events.teams.microsoft.com/event/78097fa9-a673-4f1e-8e2d-978ebd8b72ca@cb480f9d-c52c-4096-a621-442810be7029" title="Reserve your seat, Thursday 10 September">Reserve your seat</mj-button>

                <mj-text mj-class="paddit" padding="12px 32px 0"><strong>In both sessions we will cover:</strong></mj-text>
                <mj-text mj-class="paddit" padding="4px 32px 8px"><ul class="article-list">
                    <li>A live walkthrough of Grace's risk registers, audit management, governance and policy sign-off, and committee reporting.</li>
                    <li>New feature enhancements recently added to the platform, including improvements to reporting and dashboard configurability.</li>
                    <li>What is on the roadmap next.</li>
                    <li>Other governance solutions we offer.</li>
                    <li>A live Q&amp;A, so please bring your questions.</li>
                </ul></mj-text>
                <mj-text mj-class="paddit">You will be able to join 15 minutes before each session begins.</mj-text>
                <mj-text mj-class="paddit">Prefer to see it in your own environment first? We are also offering a <strong>free 30-day trial of Grace</strong>, with full support from our team to get you set up. You can <a href="https://gracegs.com/" title="Grace Governance Solutions" target="_blank">read more about Grace</a> or simply reply to this email.</mj-text>

                <mj-divider />

                <mj-text mj-class="heading">Rapid Mentor: Mentoring, Made Simple</mj-text>
                <mj-text mj-class="paddit">Alongside the systems you already rely on us for, we have developed <strong>Rapid Mentor</strong>, a simple, affordable mentoring application built for organisations balancing real development needs against limited HR and L&amp;D budgets.</mj-text>
                <mj-text mj-class="paddit" padding="8px 32px 0"><strong>What it does:</strong></mj-text>
                <mj-text mj-class="paddit" padding="4px 32px 8px"><ul class="article-list">
                    <li>Matches mentors and mentees quickly, without the manual admin.</li>
                    <li>Tracks goals, meetings and progress in one place.</li>
                    <li>Gives HR and L&amp;D visibility into how your programme is working.</li>
                    <li>Straightforward pricing, with none of the enterprise sales process.</li>
                </ul></mj-text>
                <mj-text mj-class="paddit">Because you are already a Rapid customer, we would like to offer you first access: a <strong>free 30-day trial</strong> of Rapid Mentor, with no commitment and full support from our team to get it set up.</mj-text>

                <mj-spacer height="8px" />
                <mj-text mj-class="paddit">If either of these looks useful, simply reply to this email or <a href="https://swifton.co.uk/contact/" title="Get In Touch" target="_blank">get in touch</a>, and we will get you set up.</mj-text>
                <mj-text mj-class="paddit">Best regards,</mj-text>
                <mj-text mj-class="paddit" padding="4px 32px 0">The Swifton Solutions Team</mj-text>
            </mj-column>
        </mj-section>

        <mj-raw><!-- CTA section --></mj-raw>
        <mj-section background-color="#dfd9fd" padding="44px 16px">
            <mj-column>
                <mj-text mj-class="cta-heading">Start your free 30-day trial</mj-text>
                <mj-text mj-class="cta-text">Grace, Rapid Mentor, or both. No commitment and no enterprise sales process, just a team on hand to help you get set up.</mj-text>
                <mj-button href="https://swifton.co.uk/contact/" title="Get In Touch">Get In Touch</mj-button>
            </mj-column>
        </mj-section>

        <mj-raw><!-- Footer --></mj-raw>
        <mj-section background-color="#ffffff" padding="32px 16px 12px">
            <mj-column>
                <mj-social css-class="flexy row gap-1">
                    <mj-social-element name="web-noshare" href="https://swifton.co.uk/" title="Web">Web</mj-social-element>
                    <mj-social-element name="linkedin-noshare" href="https://www.linkedin.com/company/rapid-information-systems/" title="LinkedIn">LinkedIn</mj-social-element>
                </mj-social>
                <mj-divider padding="20px 32px 8px" />
                <mj-text mj-class="footer-text"><a href="{unsubscribe_link}">Unsubscribe</a></mj-text>
            </mj-column>
        </mj-section>

        <mj-raw><!-- Bottom accent bar --></mj-raw>
        <mj-section background-color="#0070f3" padding="0">
            <mj-column>
                <mj-spacer height="4px" />
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>